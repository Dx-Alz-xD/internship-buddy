# Copy to .env.local and fill in. Only the first two are needed for the core job boards.

# Internshala scraper key: https://www.omkar.cloud/tools/internshala-scraper/about
INTERNSHALA_API_KEY=
# One RapidAPI key. Subscribe it (free plans) to: JSearch, Unstop API, Jobs API (jobs-api14),
# Hirebase Jobs Data, jobs-api21, Remote Jobs (remote-jobs1), jobs-api19 and Job Search (job-search15).
# Sources you are not subscribed to just show an error and are skipped.
RAPIDAPI_KEY=

# AI features (fit check, writing, CV reading and review, plain-English search): https://console.groq.com/keys
GROQ_API_KEY=

# Optional extra job boards. Each one switches on automatically when its key is set.
# Himalayas works without a key; a free key raises its rate limit. https://himalayas.app/signup/developer
HIMALAYAS_API_KEY=
# fantastic.jobs Job Board API (free: 100 calls / 500 jobs a month). https://fantastic.jobs
FANTASTIC_JOBS_API_KEY=
# Careerjet: free publisher key, has an internship filter for India. Keys only work from the IP
# addresses you allow in your Careerjet partner account, so add your server's IP there.
# https://www.careerjet.com/partners/register/as-publisher
CAREERJET_API_KEY=
# Adzuna: free app id + key, covers India (/jobs/in/). Their terms ask for an Adzuna logo link.
# https://developer.adzuna.com/signup
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Jooble: free key on request, 100 calls a day. Keys belong to one country portal: a jooble.org key
# returns US listings and is only used when your profile looks abroad. For India, request a key at
# https://in.jooble.org/api/about and set JOOBLE_HOST=in.jooble.org
JOOBLE_API_KEY=
JOOBLE_HOST=jooble.org
